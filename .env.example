# Copy to .env; fill actual keys locally and do not commit them.
TRACESHIELD_TASK_PROVIDER=kimi
KIMI_API_KEY=

# Built-in provider. Use auditor only after defining it in configs/providers.yaml.
TRACESHIELD_SEMANTIC_PROVIDER=deepseek
DEEPSEEK_API_KEY=
TRACESHIELD_PROTECTION_MODE=enforce

# Optional API/bench provider, distinct from the Demo roles above.
# TRACESHIELD_PROVIDER=local
# TRACESHIELD_DB_PATH=/absolute/path/to/traceshield.db
# TRACESHIELD_REHEARSAL_ENABLED=false
