    "id": "cve_2025_32711_echoleak_exfiltration",
    "cve": {
      "id": "CVE-2025-32711",
      "title": "M365 Copilot AI 命令注入 / 敏感信息泄露（EchoLeak）",
      "cvss": "7.5 HIGH（NVD）/ 9.3 CRITICAL（Microsoft，CVSS:3.1 AV:N/AC:L/PR:N/UI:N/S:C）",
      "published": "2025-06-11",
      "references": [
        "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-32711",
        "https://www.aim.security/lp/aim-labs-echoleak-m365"
      ],
      "background": "攻击者向受害者邮箱发送含隐藏指令的邮件，M365 Copilot 在处理邮件内容时\n被注入的指令劫持，在无用户交互（零点击）的情况下把敏感信息（如会话中\n接触到的凭据）通过构造的 URL 泄露给攻击者域名。\n",
      "attack_chain": [
        "零点击间接注入：邮件正文的注释/隐藏文本携带指令",
        "读取敏感内容：Agent 合法读取配置中的 API 密钥",
        "数据外发：把密钥拼接进攻击者域名的\"验证链接\"预取"
      ],
      "defense_layers": [
        "污点检测：邮件内容注入指令识别 + 密钥 exact_bytes 登记 secret 标签",
        "DSL 硬规则：deny_secret_exfiltration 阻断向非信任域外发敏感内容",
        "审计溯源：sources/labels/events 完整记录泄露链路，可重建 DAG"
      ]
    },
