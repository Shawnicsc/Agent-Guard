  {
    "id": "cve_2025_53773_copilot_autoapprove_rce",
    "cve": {
      "id": "CVE-2025-53773",
      "title": "GitHub Copilot / Visual Studio 2022 命令注入（提示注入引发 RCE）",
      "cvss": "7.8 HIGH（CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H）",
      "published": "2025-08-12",
      "references": [
        "https://msrc.microsoft.com/update-guide/vulnerability/CVE-2025-53773",
        "https://embracethered.com/blog/posts/2025/github-copilot-remote-code-execution-via-prompt-injection/"
      ],
      "background": "Copilot Agent Mode 可不经用户确认直接写工作区文件。攻击者在 Issue/网页/源码\n注释中植入间接注入，诱导 Copilot 将 \"chat.tools.autoApprove\": true 写入\n.vscode/settings.json（自批准模式），随后借终端执行任意命令达成 RCE\n（PoC 演示了 C2 回连与自我复制）。\n",
      "attack_chain": [
        "间接注入：被读取文档内嵌\"启用开发者工具\"话术",
        "自我提权：fs.write 改写 .vscode/settings.json 开启 autoApprove",
        "命令执行：curl 下载远端脚本管道执行"
      ],
      "defense_layers": [
        "污点检测：detect_injection 识别读入内容中的注入指令（UNTRUSTED_INSTRUCTION）",
        "DSL 硬规则：deny_agent_config_write 阻断 Agent 配置自我提权",
        "DSL 硬规则：deny_dangerous_command 阻断下载管道执行",
        "沙箱硬边界：exec 仅在 network=none 容器内运行"
      ]
    },
